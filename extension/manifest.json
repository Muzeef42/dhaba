{
  "manifest_version": 3,
  "name": "Dhaba Netflix Sync",
  "version": "1.0",
  "description": "Sync Netflix playback across Dhaba rooms",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "http://localhost:4000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/watch/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
